# ============================================================
# data-pipeline 环境配置模板
#
# 用法：复制为 .env 后填入真实值 ——  cp .env.example .env
# 服务启动时自动加载 .env（api 与 cleaner 都一样），查找顺序：
#   1. 当前工作目录的 .env
#   2. 仓库根目录的 .env（推荐就放这里，一个文件管全部服务）
#   3. 各服务自己目录下的 .env（apps/api/.env、workers/cleaner/.env）
# 优先级：真实环境变量（shell / pm2 env）> .env 文件，.env 只补缺，
# 永远不会覆盖已经设好的环境变量。
#
# 安全：.env 已被 .gitignore 排除，绝不要提交进仓库；
# 在服务器上建议 chmod 600 .env。
# ============================================================

# ---------------- API 服务（apps/api） ----------------

# 监听端口
PORT=8080
# 项目路径前缀（挂在 /api 前面）；置空字符串可关闭前缀
BASE_PATH=/data-pipeline
# 数据目录。生产环境务必写绝对路径（相对路径按进程工作目录算，
# pm2 从不同目录启动会落到不同的库）
DATA_DIR=/home/ec2-user/app/data-pipeline/data
# 存储实现：sqlite（默认）或 file，两者同一接口可互换
STORAGE=sqlite
# 是否开启 X-API-Key 鉴权：false（默认）或 true；开启后用
# npm run create-token -- <备注名> 发令牌（明文只打印一次，只存哈希）
AUTH_REQUIRED=false
# 单条 content 上限（字节）
MAX_CONTENT_BYTES=1048576
# 单条 prompt 上限（字节）
MAX_PROMPT_BYTES=65536
# 每身份（关鉴权时每 IP）每分钟请求上限
RATE_LIMIT_PER_MIN=60

# ---------------- 清洗服务（workers/cleaner） ----------------

# 原始记录从哪个 API 拉（默认线上已部署实例；本机联调可改成本地地址）
DATA_PIPELINE_BASE_URL=https://agent101.uk/data-pipeline
# 清洗结果 SQLite 的存放目录（cleaned.sqlite 在此目录下），生产写绝对路径
CLEANER_DATA_DIR=/home/ec2-user/app/data-pipeline/workers/cleaner/data
# 定时清洗间隔（分钟）：服务启动先跑一遍，之后每隔这么久再跑一轮
CLEANER_INTERVAL_MINUTES=60
# 单轮最多拉取多少条记录
CLEANER_LIMIT=100
# 单轮最多实际清洗多少条（控 LLM 花费的闸）
CLEANER_MAX_PER_RUN=20
# 清洗提示词文件路径（一般不用设，默认 workers/cleaner/prompts/clean.md）
# CLEANER_PROMPT_PATH=


# ---------------- Web UI（apps/web） ----------------

# web 服务端读取数用的 API 地址（须带项目前缀）。与 api 同机时保持默认即可；
# 只在「启动 web 时」需要（构建时不用）。
DATA_PIPELINE_API_URL=http://localhost:8080/data-pipeline
# Web 被反代挂在路径前缀下时才设（如 /data-ui），同时反代也要把该前缀剥掉或直通。
# NEXT_BASE_PATH=

# ---------------- 日志 ----------------

# 日志目录：两个服务的日志都落在这里（api 写 data-pipeline.log，
# cleaner 写 data-cleaner.log，带时间戳、追加写入）。
# 相对路径按仓库根目录算；不设时默认就是仓库根的 logs/。
LOG_DIR=logs
# 单个服务改文件名时才需要（一般不用设）：
# DATA_PIPELINE_LOG_FILE=
# DATA_CLEANER_LOG_FILE=

# ---------------- LLM（清洗用，OpenAI 兼容接口） ----------------

# ★ 真实 Key 填这里。不填则 cleaner 自动降级为 mock provider
# （启发式拆条、结果带 mock 标记），不会真调模型。
LLM_API_KEY=
# 接口地址：默认 OpenRouter；用 OpenAI 官方改 https://api.openai.com/v1，
# 用其他兼容厂商改成其 /v1 地址即可，不用改代码
LLM_BASE_URL=https://openrouter.ai/api/v1
# 模型名（按上面接口的命名；OpenRouter 示例：openai/gpt-4o-mini）
LLM_MODEL=openai/gpt-4o-mini
