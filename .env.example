PORT=8080
BASE_PATH=/data-pipeline
DATA_DIR=./data
STORAGE=sqlite
AUTH_REQUIRED=false
MAX_CONTENT_BYTES=1048576
MAX_PROMPT_BYTES=65536
RATE_LIMIT_PER_MIN=60

# cleaner (workers/cleaner)
DATA_PIPELINE_BASE_URL=https://agent101.uk/data-pipeline
CLEANER_DATA_DIR=./workers/cleaner/data
CLEANER_INTERVAL_MINUTES=60
CLEANER_LIMIT=100
CLEANER_MAX_PER_RUN=20
# LLM (OpenAI-compatible). Without LLM_API_KEY the cleaner uses the mock provider.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
