{
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.469.0",
    "multer": "^1.4.5-lts.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "description": "文档阅读平台（Agent 101 界面）：按分类管理、阅读 HTML 文档；由 joesaas/doc-reader 原样迁入 data-pipeline/apps/docs，历史数据不迁移",
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "name": "@data-pipeline/docs",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.server.json && vite build --config vite.config.ts",
    "dev": "concurrently -k -n server,client \"tsx watch server/src/index.ts\" \"vite --config vite.config.ts\"",
    "dev:client": "vite --config vite.config.ts",
    "dev:server": "tsx watch server/src/index.ts",
    "import:am": "tsx scripts/import-am.ts",
    "smoke": "node scripts/smoke.mjs",
    "start": "node dist/server/src/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "smoke:ai": "node scripts/smoke-ai.mjs"
  },
  "type": "module",
  "version": "0.2.0"
}
