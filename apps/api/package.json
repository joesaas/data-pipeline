{
  "dependencies": {
    "ethers": "^6.17.0",
    "express": "^4.19.2"
  },
  "description": "API app: ingest and query service for prompt+content records (Express, storage driver dual implementation).",
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22"
  },
  "name": "@data-pipeline/api",
